{
  "expo": {
    "name": "doop",
    "slug": "doop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "doop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Doop uses your location to track walks.",
        "NSPhotoLibraryUsageDescription": "Doop uses your photo library for dog and stool photos.",
        "NSCameraUsageDescription": "Doop uses your camera to photograph stool samples for your vet."
      },
      "bundleIdentifier": "com.anonymous.doop"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.doop"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Doop uses your location to track walks."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Doop uses your photo library for dog and stool photos.",
          "cameraPermission": "Doop uses your camera to photograph stool samples for your vet."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
